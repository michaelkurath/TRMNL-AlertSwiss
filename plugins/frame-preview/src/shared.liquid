          </g>
          {% for alert in data.alerts reversed %}
            <g fill="{{ alert.color }}" fill-opacity=".42" stroke="{{ alert.color }}" stroke-width="2.2" fill-rule="evenodd" stroke-linejoin="round">
              {% for shape in alert.shapes %}
                {% if shape.path %}
                  <path d="{{ shape.path }}"/>
                {% else %}
                  <ellipse cx="{{ shape.cx }}" cy="{{ shape.cy }}" rx="{{ shape.rx }}" ry="{{ shape.ry }}"/>
                {% endif %}
              {% endfor %}
            </g>
          {% endfor %}
          {% for alert in data.alerts %}
            {% if alert.marker %}
              <g aria-hidden="true">
                <line x1="{{ alert.marker.x }}" y1="{{ alert.marker.y }}" x2="{{ alert.marker.mx }}" y2="{{ alert.marker.my }}" stroke="{{ alert.color }}" stroke-width="2"/>
                <circle cx="{{ alert.marker.mx }}" cy="{{ alert.marker.my }}" r="13" fill="{{ alert.color }}" stroke="white" stroke-width="2.1"/>
                <text x="{{ alert.marker.mx }}" y="{{ alert.marker.my }}" text-anchor="middle" dominant-baseline="central" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="white">{{ alert.number }}</text>
              </g>
            {% endif %}
          {% endfor %}
        </svg>
        <div class="as-legend" aria-label="Canton colour key">
          <span>Canton level</span>
          <span class="as-key" style="--as-key:#f47070">Alert</span>
          <span class="as-key" style="--as-key:#ffcb42">Warning</span>
          <span class="as-key" style="--as-key:#7bbce9">Information</span>
          <span class="as-key" style="--as-key:#87d19b">All-clear</span>
          {% if data.hasOtherLevel %}<span class="as-key" style="--as-key:#aeb9bd">Other notice</span>{% endif %}
        </div>
      </div>

      <section class="as-list" aria-label="Notices">
        <h2>Notices</h2>
        {% if data.scope %}<p class="as-scope">{{ data.scope | escape }}{% if data.nationwideCount > 0 %} · {{ data.nationwideCount }} nationwide{% endif %}</p>{% endif %}
        {% if data.available != true %}
          <div class="as-state as-state--missing"><h3>Data unavailable</h3><p>Check alert.swiss or the official app for current notices.</p></div>
        {% elsif data.alerts == blank %}
          <div class="as-state"><h3>No matching notices</h3><p>No notices in this snapshot match the selected cantons.</p></div>
        {% else %}
          {% for alert in data.alerts %}
            <article class="as-item" style="--as-level:{{ alert.color }};--as-tint:{{ alert.tint }}">
              <span class="as-num">{{ alert.number }}</span>
              <div>
                <p class="as-meta">
                  <span class="as-level">{{ alert.levelLabel }}{% if alert.isTest %} · Test message{% endif %}</span>
                  {% if alert.nationwide %}<span>Nationwide</span>
                  {% elsif alert.region != blank %}<span class="as-region">{{ alert.region | escape }}</span>{% endif %}
                </p>
                <h3 class="as-title">{{ alert.title | strip_html | escape }}</h3>
                {% if alert.instructions != blank %}
                  <p class="as-copy">{{ alert.instructions.first | strip_html | escape }}</p>
                {% elsif alert.description != blank %}
                  <p class="as-copy">{{ alert.description | strip_html | escape }}</p>
                {% endif %}
              </div>
            </article>
          {% endfor %}
          {% if data.hidden > 0 %}<p class="as-more">+{{ data.hidden }} more in the snapshot</p>{% endif %}
        {% endif %}
      </section>
    </div>

    <footer class="as-foot">
      <span>Map ©swisstopo{% unless as_is_demo %} · Source: www.alert.swiss{% endunless %}</span>
      <span>{% if as_is_demo %}Simulated notices{% elsif data.snapshotCheckedAt != blank %}Feed checked {{ data.snapshotCheckedAt | escape }}{% elsif data.available %}Snapshot freshness unverified{% endif %}</span>
    </footer>
  </div>
</div>
{% endcapture %}
