{% assign as_display = trmnl.plugin_settings.custom_fields_values.display_style | default: 'auto' | downcase %}
{% unless as_display == 'map' or as_display == 'classic' %}{% assign as_display = 'auto' %}{% endunless %}
{% assign as_data_mode = trmnl.plugin_settings.custom_fields_values.preview_mode | default: 'demo' | downcase %}
{% assign as_is_demo = data.demo %}
{% if data == blank and as_data_mode != 'live' %}{% assign as_is_demo = true %}{% endif %}
<style>
.as-frame { display:none; position:absolute; inset:0; container-type:size; color:#102840; background:#eaf5fb; font-family:Arial,sans-serif }
.as-classic { display:contents }
.screen--frame .as-frame--auto, .as-frame--map { display:block }
.screen--frame .as-classic--auto, .as-classic--map { display:none }
.as-board, .as-board * { box-sizing:border-box }
.as-board { position:absolute; inset:0; display:grid; grid-template-rows:auto minmax(0,1fr) auto; font-size:clamp(12px,2.23cqmin,40px); line-height:1.19 }
.as-head { display:flex; align-items:center; justify-content:space-between; gap:.7em; background:#123f6b; color:#fff; padding:1.4cqh 2.1cqw }
.as-brand { display:flex; align-items:center; gap:.52em; min-width:0 }
.as-brand svg { width:1.75em; height:1.75em; flex:none }
.as-head h1 { margin:0; color:inherit; font-size:2.45em; line-height:1; letter-spacing:-.04em; white-space:nowrap }
.as-mode { margin:0; padding:.35em .62em; font-size:.71em; font-weight:700; text-align:right; background:#fff; color:#123f6b; border-radius:.22em }
.as-mode--demo { background:#ffe467; color:#252017 }
.as-body { display:grid; grid-template-columns:minmax(0,1.92fr) minmax(0,1fr); min-height:0 }
.as-map { min-width:0; min-height:0; display:grid; grid-template-rows:minmax(0,1fr) auto; background:#e1f1fc }
.as-map svg { display:block; width:100%; height:100%; padding:.3em; min-height:0 }
.as-legend { display:flex; flex-wrap:wrap; justify-content:center; gap:.3em .85em; padding:.42em .7em .57em; background:#cde7f7; font-size:.75em; font-weight:700 }
.as-key { display:inline-flex; align-items:center; gap:.27em; white-space:nowrap }
.as-key::before { content:""; width:.7em; height:.7em; display:inline-block; background:var(--as-key); border-radius:.13em }
.as-list { display:flex; flex-direction:column; gap:.3em; min-height:0; min-width:0; overflow:hidden; padding:.56em .64em .4em; background:#f4f8fb; border-left:2px solid #9bc5df }
.as-list h2 { margin:0; font-size:1.53em; line-height:1.03; letter-spacing:-.035em }
.as-scope { margin:0 0 .15em; color:#2c4c67; font-size:.79em; font-weight:600 }
.as-item { display:grid; grid-template-columns:1.48em minmax(0,1fr); align-content:center; gap:.43em; min-height:0; flex:1 0 auto; max-height:5em; padding:.33em .38em .33em .45em; margin:0; border-left:.20em solid var(--as-level); border-radius:.28em; background:var(--as-tint) }
.as-num { display:grid; place-items:center; border-radius:100%; width:1.43em; height:1.43em; color:#fff; background:var(--as-level); font-weight:700 }
.as-meta { display:flex; align-items:center; gap:.42em; margin:0; color:#213b50; font-size:.74em; font-weight:700; white-space:nowrap }
.as-level { color:var(--as-level); flex:none }
.as-meta .as-region { min-width:0; overflow:hidden; text-overflow:ellipsis }
.as-title, .as-copy { margin:.10em 0 0; display:-webkit-box; -webkit-box-orient:vertical; overflow:hidden; overflow-wrap:anywhere }
.as-title { font-size:1.04em; font-weight:700; -webkit-line-clamp:2 }
.as-copy { font-size:.87em; -webkit-line-clamp:1 }
.as-state { margin-top:.22em; padding:.72em; background:#d9edfa; border-left:.18em solid #296893; border-radius:.25em }
.as-state--missing { background:#fff1b7; border-color:#a15b00 }
.as-state h3 { margin:0; font-size:1.25em; line-height:1.08 }
.as-state p { margin:.35em 0 0; font-size:.87em }
.as-foot { display:flex; justify-content:space-between; gap:.5em; padding:.48em 1cqw; background:#123f6b; color:#fff; font-size:.70em }
.as-foot span:last-child { text-align:right }
.as-more { margin:0; color:#2c4c67; font-size:.72em }
@container (aspect-ratio < 1/1) {
  .as-board { font-size:clamp(12px,2.32cqw,38px) }
  .as-body { grid-template-columns:1fr; grid-template-rows:min(51%, 77cqw) minmax(0,1fr) }
  .as-list { border-left:none; border-top:2px solid #9bc5df }
  .as-item { max-height:4.75em }
  .as-list:has(.as-item:nth-of-type(4)) .as-item { max-height:none; flex:1 1 auto }
}
@container (aspect-ratio > 2.3/1) {
  .as-board { font-size:clamp(12px,2.65cqh,32px) }
  .as-body { grid-template-columns:minmax(0,1.15fr) minmax(0,1fr) }
}
@container (max-height:790px) and (min-aspect-ratio:1/1) {
  .as-title { -webkit-line-clamp:1 }
}
@container (max-height:1500px) and (aspect-ratio < 1/1) {
  .as-board { font-size:clamp(12px,2.07cqmin,26px) }
  .as-body { grid-template-rows:min(46%, 77cqw) minmax(0,1fr) }
  .as-title { -webkit-line-clamp:1 }
}
@container (aspect-ratio < 0.43) {
  .as-board { font-size:clamp(12px,3.6cqw,36px) }
  .as-title { -webkit-line-clamp:3 }
  .as-copy { -webkit-line-clamp:2 }
}
@container (max-height:480px) {
  .as-copy { display:none }
  .as-head h1 { font-size:1.82em }
}
</style>
