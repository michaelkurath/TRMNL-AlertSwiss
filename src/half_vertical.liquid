{%- assign alerts = data.alerts -%}
{%- assign cantons = data.cantons -%}

<div class="layout layout--top">
  {%- if alerts == blank -%}
  <div class="stack">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="title">No active alerts</span>

        <span class="label  label--outline">
          Cantons: {%- if cantons and cantons.size > 0 -%}{{ cantons | join: ", " }}{%- else -%}All{%- endif -%}
        </span>

        <span class="description" data-clamp="3">
          Nothing matches your current filter. If you still expect an alert, check the Alertswiss app/website or broaden your canton list.
        </span>

        <div class="flex gap--small">
          <span class="label ">Tip:</span>
          <span class="label " data-clamp="2">
            Add "CH" to cantons to show all Swiss alerts (including nationwide).
          </span>
        </div>
      </div>
    </div>
  </div>
  {%- else -%}
  <div class="columns" data-overflow-max-cols="1" data-overflow-counter="true">
    <div class="column">
      {%- for a in alerts limit: data.limit -%}
      <div class="item">
        <div class="meta"></div>

        <div class="content">
          <span class="title title--small" data-clamp="2">
            {%- if a.region != "" -%}{{ a.region }} - {%- endif -%}{{ a.title }}
          </span>

       

          {%- if a.description != "" -%}
          <span class="description" data-clamp="3">{{ a.description }}</span>
          {%- endif -%}

          {%- if a.instructions != blank -%}
          <span class="label label--small">Recommendations for the public</span>

          {%- comment -%}Handle both array and string cases without inline styles{%- endcomment -%}
          {%- if a.instructions.size and a.instructions.first -%}
          {%- for line in a.instructions -%}
          {%- if line != "" -%}
          <span class="description" data-clamp="2">• {{ line }}</span>
          {%- endif -%}
          {%- endfor -%}
          {%- else -%}
          <span class="description" data-clamp="4">{{ a.instructions | replace: "
            ", " • " }}</span>
          {%- endif -%}
          {%- endif -%}
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</div>

